{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "forbiddenText", "ignoredPaths", "requiredPaths", "release", "publication"],
  "properties": {
    "$schema": { "type": "string" },
    "forbiddenText": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "ignoredPaths": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "requiredPaths": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filenamePattern", "sections"],
      "properties": {
        "filenamePattern": { "type": "string", "minLength": 1 },
        "sections": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common", "stableControlPlane"],
      "properties": {
        "common": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
        "stableControlPlane": { "$ref": "#/$defs/nonEmptyUniqueStrings" }
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
