{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../.heap/build/qt/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KERO_RELEASE_DIRECTORY": "${sourceDir}/../../.heap/build/releases/${presetName}"
      }
    },
    {
      "name": "windows-arm64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "ARM64",
        "CMAKE_CXX_COMPILER": "$env{KERO_CXX_COMPILER}",
        "CMAKE_RC_COMPILER": "$env{KERO_MSVC_RC}",
        "CMAKE_MT": "$env{KERO_MSVC_MT}"
      }
    },
    {
      "name": "windows-x64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_CXX_COMPILER": "$env{KERO_CXX_COMPILER}",
        "CMAKE_RC_COMPILER": "$env{KERO_WINDRES}"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER": "$env{KERO_C_COMPILER}",
        "CMAKE_CXX_COMPILER": "$env{KERO_CXX_COMPILER}",
        "CMAKE_LIBRARY_PATH": "$env{KERO_LINUX_SYSROOT}/usr/lib/x86_64-linux-gnu",
        "QT_HOST_PATH": "$env{KERO_QT_HOST_PATH}"
      }
    },
    {
      "name": "linux-arm64",
      "inherits": "base",
      "cacheVariables": { "CMAKE_SYSTEM_NAME": "Linux", "CMAKE_SYSTEM_PROCESSOR": "aarch64" }
    }
  ]
}
